      "description": "Base64-decoded payload piped to shell"
    },
    {
      "id": "base64_decode_to_shell2",
      "pattern": "(base64\\s+(-d|--decode)\\s*.*?\\|\\s*(\\/bin\\/)?(ba)?sh)\\b",
      "description": "Base64-decoded payload piped to shell"
    },
    {
      "id": "python_obfuscated_exec",
      "pattern": "(python[23]?(?:\\s+-c)?\\s*['\"].*?(?:base64|exec|eval|__import__)\\s*.*?['\"])",
      "description": "Obfuscated Python execution"
    },
    {
      "id": "perl_obfuscated_exec",
