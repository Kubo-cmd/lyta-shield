    },
    {
      "id": "eval_dynamic_exec",
      "pattern": "\\b(eval\\s*\\(|\\beval\\s+['\"]\\$|\\bexec\\s+\\$\\(curl)\\b",
      "description": "Eval dynamic execution"
    },
    {
      "id": "paste_jacking_suspicious_1",
      "pattern": "\\b(paste\\s+(?:this\\s+)?(?:code|command|text|script)\\s+(?:into|in|inside|to)\\s+(?:the\\s+)?(?:your\\s+)?(?:terminal|shell|console|command\\s+line|prompt|window))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_suspicious_2",
      "pattern": "(copy\\s+(?:the\\s+following\\s+)?(?:code|command|script|text|this)\\s+(?:into|in|to|inside)\\s+(?:the\\s+)?(?:your\\s+)?(?:terminal|shell|console|command\\s+line|prompt|window))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "irc_handler_invitation",
      "pattern": "\\b(?:you|we|lets|let's)\\s+.*?(?:open|start|get|join|connect|create)\\s+(?:an?\\s+)?(?:irc|znc|bnc)\\b",
      "description": "Invitation to join IRC/ZNC directed at reader"
    },
    {
      "id": "irc_handler_network",
      "pattern": "\\b(?:you|we|lets|let's)\\s+.*?(?:open|start|get|join|connect|create)\\s+(?:an?\\s+)?(?:irc|znc|bnc)\\b.*?\\b(?:handler|underworld|fedex|dark|underground|market|warez|carding|hackers)\\b",
      "description": "Invitation to criminal IRC/handler network directed at reader"
    },
    {
      "id": "irc_handler_recruit",
      "pattern": "\\b(?:you should|you can|we should|let's|lets)\\s+.*?(?:irc|znc|bnc).*?(?:handler|underworld|dark|hackers|underground|market|warez|carding)",
      "description": "Recruitment to criminal IRC/handler network"
    },
    {
      "id": "irc_handler_connect",
      "pattern": "(?<!rule for \")(?<!rule for \\')(?<!rule for \\')(?<!rule \\')(?<!rule \")(?<!rule: )(?<!example )(?<!test )(?<!audit )(?<!discussion )(?<!the rule \\')(?<!the rule \")\\b(?:connect|start|getting)\\s+(?:with|into)\\s+(?:the\\s+)?(?:underworld|hackers|dark|market|warez|carding|handler)\\b(?![\\s\\w\\'\"\\-]*(?:to understand|to study|to learn|to defend|to protect|to research|in the document|in the report|for research))",
      "description": "Invitation to connect with criminal networks"
    },
    {
      "id": "security_disable",
      "pattern": "\\b(disable\\s+(?:security|gatekeeper|sip|sudoers|firewall|defender))\\b",
      "description": "Security disable attempt"
    },
    {
      "id": "macos_security_disable",
      "pattern": "\\b(spctl\\s+--master-disable|csrutil\\s+disable)\\b",
      "description": "macOS security disable"
    },
    {
      "id": "browser_dynamic_code",
      "pattern": "\\b(Function\\s*\\(\\s*\\)|new\\s+Function\\s*\\(\\s*['\"].*?\\)|setTimeout\\s*\\(\\s*['\"].*?\\)|setInterval\\s*\\(\\s*['\"].*?\\))",
      "description": "Browser dynamic code execution"
    }
  ],
  "safe_installers": [
