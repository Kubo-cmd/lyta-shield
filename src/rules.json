    },
    {
      "id": "remote_fetch_tmp_executable",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\s+-o\\s+/tmp/\\w+\\s*\\;\\s*chmod\\s*\\+x",
      "description": "Remote fetch tmp executable"
    },
    {
      "id": "package_manager_pipe",
      "pattern": "\\b(pip|npm|gem|cargo)\\s+install\\s+[^\\s]+\\s*\\|\\s*(ba)?sh\\b",
