      "description": "Download, chmod, and execute from tmp"
    },
    {
      "id": "paste_jacking_1",
      "pattern": "(paste\\s+this\\s+(?:command|code)\\s+(?:into|in)\\s+(?:your\\s+)?(?:terminal|shell|console))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_2",
      "pattern": "(copy\\s+this\\s+(?:command|code|script|text)\\s+(?:and\\s+)?(?:paste|run|execute)\\s+it)\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_3",
      "pattern": "(copy\\s+(?:and\\s+)?paste\\s+(?:this\\s+)?(?:command|code|script|text))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_4",
      "pattern": "(copy\\s+(?:the\\s+following\\s+)?(?:command|code|script|text)\\s+(?:and\\s+)?paste\\s+(?:it\\s+)?(?:into|in|to)\\s+(?:the\\s+)?(?:your\\s+)?(?:terminal|shell|console|command\\s+line|prompt))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_5",
      "pattern": "(paste\\s+(?:the\\s+following\\s+)?(?:command|code|script|text)\\s+(?:into|in|to)\\s+(?:the\\s+)?(?:your\\s+)?(?:terminal|shell|console|command\\s+line|prompt))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_6",
      "pattern": "(copy\\s+(?:the\\s+following\\s+)?(?:script|command|code)\\s+(?:into|in|to)\\s+(?:the\\s+)?(?:your\\s+)?(?:terminal|shell|console|command\\s+line|prompt))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_7",
      "pattern": "(run\\s+this\\s+(?:command|code)\\s+in\\s+(?:your\\s+)?(?:terminal|shell|console))\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_8",
      "pattern": "(website|page|link|site|popup)\\s+(?:told|asked|instructed|said|says|wants|tells)\\s+(?:me|you|us|him|her)\\s+(?:to\\s+)?(?:copy|paste|run|execute|type|put|enter)\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_9",
      "pattern": "(?:copy|paste|run|execute|type|put|enter)\\s+(?:this\\s+)?(?:code|command|script|text|thing)?\\s*(?:in|into|inside|to)\\s+(?:the\\s+)?(?:your\\s+)?(?:terminal|shell|console|command[-\\s]?line|prompt|window|box|field)\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_10",
      "pattern": "\\b(put|type|enter|paste)\\s+(?:this\\s+)?(?:code|command|script|text|thing)?\\s*(?:in|into|inside|to)\\s+(?:the\\s+)?(?:your\\s+)?(?:command[-\\s]?line|terminal|shell|console|prompt|window)\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_11",
      "pattern": "\\b(?:copy|paste)\\s+(?:this\\s+)?(?:command|code|script|text)?\\s*(?:into|in|to|inside)\\s+(?:the\\s+)?(?:your\\s+)?(?:shell|terminal|console)\\b",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_12",
      "pattern": "(?:advised|told|asked|instructed)\\s+(?:me|you|us|him|her)?\\s*(?:to\\s+)?(?:copy|paste)\\s+(?:this\\s+)?(?:command|code|script|text)?\\s*(?:into|in|to|inside)\\s+(?:the\\s+)?(?:your\\s+)?(?:shell|terminal|console)",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "paste_jacking_13",
      "pattern": "<[^>]+>\\s*(?:copy|paste)\\s*(?:<[^>]+>\\s*)?(?:this\\s+)?(?:command|code|script|text)?(?:<[^>]+>\\s*)?(?:and\\s+)?(?:<[^>]+>\\s*)?(?:paste\\s+)?(?:it\\s+)?(?:into|in|to|inside)\\s+(?:the\\s+)?(?:your\\s+)?(?:shell|terminal|console)",
      "description": "Paste-jacking instruction with HTML tags"
    },
    {
      "id": "paste_jacking_14",
      "pattern": "(?:copy|paste)\\s+(?:<[^>]+>\\s*)?(?:this\\s+)?(?:<[^>]+>\\s*)?(?:command|code|script|text)(?:<[^>]+>\\s*)?(?:and\\s+)?(?:<[^>]+>\\s*)?(?:paste\\s+)?(?:it\\s+)?(?:into|in|to|inside)\\s+(?:the\\s+)?(?:your\\s+)?(?:shell|terminal|console)",
      "description": "Paste-jacking instruction"
    },
    {
      "id": "copy_paste_shell",
      "pattern": "\\bcopy\\s+(?:<[^>]+>\\s*)?(?:this\\s+)?(?:<[^>]+>\\s*)?(?:command|code|script|text)?(?:<[^>]+>\\s*)?.*?\\bpaste\\s+(?:it\\s+)?(?:into|in|to|inside)\\s+(?:the\\s+)?(?:your\\s+)?(?:shell|terminal|console)",
      "description": "Copy and paste into shell"
    },
    {
      "id": "paste_jacking_15",
      "pattern": "\\b(?:bash|sh)\\s+-c\\s*['\"].*?(?:curl|wget|fetch)\\b",
      "description": "Shell -c with remote fetch"
    },
    {
      "id": "bash_c_remote_fetch",
      "pattern": "bash\\s+-c\\s*['\"].*?(?:curl|wget|fetch)\\s+(?:-fsSL\\s+)?['\"]?https?://",
      "description": "bash -c containing remote fetch"
    },
    {
      "id": "sh_c_remote_fetch",
      "pattern": "sh\\s+-c\\s*['\"].*?(?:curl|wget|fetch)\\s+(?:-fsSL\\s+)?['\"]?https?://",
      "description": "sh -c containing remote fetch"
    },
    {
      "id": "destructive_command",
      "pattern": "\\b(rm\\s+-rf\\s+/\\s*$|rm\\s+-rf\\s+~\\s*$|rm\\s+-rf\\s+\\$HOME\\s*$|rm\\s+-rf\\s+/\\w+|rm\\s+-rf\\s+/\\w+/\\w+|mkfs\\.|>:\\s*\\{\\}\\;|fork\\s+bomb)\\b",
      "description": "Destructive command"
    },
    {
      "id": "destructive_command2",
      "pattern": "\\b(rm\\s+-rf\\s+/|rm\\s+-rf\\s+~|rm\\s+-rf\\s+\\$HOME)\\s*$",
      "description": "Destructive command"
    },
    {
      "id": "destructive_command3",
      "pattern": "\\b(dd\\s+if=/dev/zero\\s+of=/dev/[sh]d[a-z])\\b",
      "description": "Destructive disk wipe"
    },
    {
      "id": "download_and_execute_tmp",
      "pattern": "\\b(sudo\\s+)?(chmod\\s+\\+x\\s+/tmp/.*\\s*\\&\\&\\s*\\S+/tmp/\\w+)\\b",
      "description": "Download and execute from tmp"
    },
    {
      "id": "reverse_shell_1",
      "pattern": "\\b(nc\\s+-e\\s+|netcat\\s+-e\\s+)\\S|bash\\s+-i\\s+>&\\s+/dev/tcp/",
      "description": "Reverse shell"
    },
    {
      "id": "reverse_shell_2",
      "pattern": "\\b/dev/tcp/\\d+\\.\\d+\\.\\d+\\.\\d+/\\d+\\s+\\|\\s*(ba)?sh\\b",
      "description": "Reverse shell"
    },
    {
      "id": "browser_eval",
      "pattern": "\\b(eval\\s*\\(\\s*['\"].*?(?:exec|system|cookie|localStorage|fetch|XMLHttpRequest|document\\.write|child_process|require\\s*\\(\\s*['\"])|\\beval\\s*\\(\\s*\\'\\s*\\d+)\\b",
      "description": "Browser eval of dangerous or dynamic code"
    },
    {
      "id": "browser_eval_alert_one",
      "pattern": "\\beval\\s*\\(\\s*(['\"])\\s*alert\\s*\\(\\s*1\\s*\\)\\s*;?\\s*\\1\\s*\\)",
      "description": "Browser eval of alert(1)"
    },
    {
      "id": "browser_eval_document_location_external",
      "pattern": "\\beval\\s*\\(\\s*(['\"])\\s*document\\.location\\s*=\\s*(['\"])https?://[^/'\"\\s)]+(?:/[^'\"\\s)]*)?\\2\\s*;?\\s*\\1\\s*\\)",
      "description": "Browser eval assigning document.location to an external URL"
    },
    {
      "id": "browser_eval_simple",
      "pattern": "\\b(eval\\s*\\(\\s*['\"](?:\\d+\\s*[-+*/])\\d+['\"])\\b",
      "description": "Browser eval of simple math"
    },
    {
      "id": "browser_remote_fetch",
      "pattern": "\\b(fetch\\s*\\(\\s*['\"]https?://|XMLHttpRequest\\s*\\(|navigator\\.sendBeacon\\s*\\(\\s*['\"]https?://)",
      "description": "Browser remote fetch"
    },
    {
      "id": "browser_worker_remote",
      "pattern": "\\b(Worker\\s*\\(\\s*['\"]https?://|SharedWorker\\s*\\(\\s*['\"]https?://|importScripts\\s*\\(\\s*['\"]https?://)",
      "description": "Browser remote worker"
    },
    {
      "id": "browser_dom_injection",
      "pattern": "\\b(document\\.write\\s*\\(|document\\.body\\.innerHTML\\s*=)",
      "description": "Browser DOM injection"
    },
    {
      "id": "credential_exfil",
      "pattern": "\\b(localStorage\\s*\\[\\s*['\"]apiKey|sessionStorage\\s*\\[\\s*['\"]apiKey|process\\.env\\s*\\.\\s*\\w*[kK]ey\\w*)",
      "description": "Credential exfiltration"
    },
    {
      "id": "browser_credential_phishing",
      "pattern": "\\b(prompt\\s*\\(\\s*['\"]Please\\s+enter\\s+your\\s+(?:password|token|key|secret)|confirm\\s*\\(\\s*['\"].*?(?:password|token|key|secret))\\b",
      "description": "Browser credential phishing"
    },
    {
      "id": "source_process_substitution",
      "pattern": "\\b(source|\\.)\\s*<\\s*\\(\\s*(curl|wget|fetch)\\s+.*\\)",
      "description": "source process substitution with remote fetch"
    },
    {
      "id": "eval_command_substitution",
      "pattern": "\\beval\\s*\\$\\s*\\(\\s*(curl|wget|fetch)\\s+",
      "description": "eval with command substitution of remote fetch"
    },
    {
      "id": "bash_process_substitution",
      "pattern": "\\b(?:ba)?sh\\s*<\\s*\\(\\s*(curl|wget|fetch)\\s+",
      "description": "bash process substitution with remote fetch"
    },
    {
      "id": "curl_download_and_execute",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\s+(?:>\\s+|\\-o\\s+)\\S+\\s+&&\\s+chmod\\s+\\+x\\s+\\S+\\s+&&\\s+(?:sudo\\s+)?(?:(?:\\.\\/|\\/)[^\\s]+|bash\\s+[^\\s]+|sh\\s+[^\\s]+)\\b",
      "description": "download with curl, chmod, then execute"
    },
    {
      "id": "curl_download_to_bash",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\s+(?:>\\s+|\\-o\\s+)\\S+\\.sh\\s*(?:&&|;)\\s*(?:ba)?sh\\s+\\S+\\.sh\\b",
      "description": "download sh script and execute with bash"
    },
    {
      "id": "curl_fetch_sequential_bash",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\s*(?:;|&&|\\|\\|)\\s*(?:ba)?sh\\b",
      "description": "remote fetch then bash sequentially"
    },
    {
      "id": "curl_awk_system",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\|\\s*awk\\s+.*?\\{\\s*system\\s*\\(",
      "description": "pipe remote fetch to awk system"
    },
    {
      "id": "curl_env_bash",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\|\\s*env\\s+(?:ba)?sh\\b",
      "description": "pipe remote fetch to env bash"
    },
    {
      "id": "python_curl_command_substitution",
      "pattern": "\\bpython[23]?\\s+-c\\s+[\"\\x27]\\s*\\$\\s*\\(\\s*(curl|wget|fetch)\\s+",
      "description": "python -c with command substitution of remote fetch"
    },
    {
      "id": "perl_curl_command_substitution",
      "pattern": "\\bperl\\s+-e\\s+[\"\\x27].*?\\$\\s*\\(\\s*(curl|wget|fetch)\\s+",
      "description": "perl -e with command substitution of remote fetch"
    },
    {
      "id": "unquoted_base64_to_python",
      "pattern": "\\b(?:echo|printf)\\s+[A-Za-z0-9+/=\\s]{20,}\\s*\\|\\s*base64\\s+(-d|--decode)\\s*\\|\\s*python[23]?\\b",
      "description": "unquoted base64 decode to python"
    }
  ],
  "suspicious": [
    {
      "id": "remote_fetch_to_interpreter",
      "pattern": "\\b(curl|wget|fetch)\\b.*?\\|\\s*(python[23]?|perl|ruby|node)\\b",
      "description": "Remote fetch to interpreter"
    },
    {
      "id": "remote_fetch_to_shell_s",
