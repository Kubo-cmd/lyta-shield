      "description": "Obfuscated Perl execution"
    },
    {
      "id": "ruby_obfuscated_exec",
      "pattern": "(ruby\\s+-e\\s*['\"].*?(?:exec|eval|system)\\s*.*?['\"])",
      "description": "Obfuscated Ruby execution"
